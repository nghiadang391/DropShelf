<Window x:Class="DropShelf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropShelf Settings" 
        Height="360" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5202020"
        Foreground="White"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="DropShelf Settings" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,16"/>

        <!-- Settings Groups -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- General Section -->
                <TextBlock Text="GENERAL" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,0,0,6"/>
                <Border Background="#1AFFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox x:Name="StartupCheckBox" Content="Launch DropShelf at Windows Startup" Click="StartupCheckBox_Click"/>
                        <CheckBox x:Name="TrayCheckBox" Content="Show DropShelf in System Tray" IsChecked="True" Click="TrayCheckBox_Click"/>
                    </StackPanel>
                </Border>

                <!-- Hotkey & Trigger Section -->
                <TextBlock Text="TRIGGERS" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,0,0,6"/>
                <Border Background="#1AFFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,4,0,4">
                            <TextBlock Text="Global Shortcut:" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="#33FFFFFF" CornerRadius="4" Padding="8,3,8,3">
                                <TextBlock Text="Win + Shift + D" FontFamily="Consolas" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Shake cursor while dragging files to spawn shelf" Margin="0,8,0,0" FontSize="12" Foreground="#88FFFFFF"/>
                    </StackPanel>
                </Border>

                <!-- Audio Section -->
                <TextBlock Text="AUDIO &amp; FEEDBACK" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,0,0,6"/>
                <Border Background="#1AFFFFFF" CornerRadius="8" Padding="12">
                    <CheckBox x:Name="SoundCheckBox" Content="Play sound effects on shelf spawn &amp; drop" IsChecked="True" Click="SoundCheckBox_Click"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Button Grid.Row="2" Content="Done" HorizontalAlignment="Right" Width="80" Height="30" Margin="0,16,0,0" Click="DoneButton_Click"/>
    </Grid>
</Window>
