<Window x:Class="DropShelf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DropShelf" 
        Height="250" Width="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container Card -->
    <Border x:Name="MainContainer"
            Margin="10"
            CornerRadius="24"
            Background="#D018181B"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            AllowDrop="True"
            DragEnter="Border_DragEnter"
            DragOver="Border_DragOver"
            Drop="Border_Drop">
        
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="Black" Opacity="0.45"/>
        </Border.Effect>

        <Grid Margin="12,10,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content (Stack / Empty) -->
                <RowDefinition Height="Auto"/> <!-- Bottom Pill -->
            </Grid.RowDefinitions>

            <!-- Header Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseDown" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Actions Menu Button -->
                <Button Grid.Column="0" Content="⋮" Style="{StaticResource HeaderButtonStyle}" Click="MenuButton_Click"/>

                <!-- Grabber / Drag Window Title -->
                <TextBlock Grid.Column="1" Text="DropShelf" 
                           Foreground="#88FFFFFF" 
                           FontSize="11" 
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>

                <!-- Pin Button -->
                <Button x:Name="PinButton" Grid.Column="2" Margin="0,0,4,0" Content="📌" 
                        Style="{StaticResource HeaderButtonStyle}" Click="PinButton_Click"/>

                <!-- Close Button -->
                <Button Grid.Column="3" Content="✕" Style="{StaticResource HeaderButtonStyle}" Click="CloseButton_Click"/>
            </Grid>

            <!-- Content Area: Empty Drop Target OR Stacked Cards OR Expanded Grid -->
            <Grid Grid.Row="1" Margin="0,8,0,8">
                <!-- Empty State -->
                <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📥" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Drop items here" FontSize="12" FontWeight="Medium" Foreground="#AAFFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="or shake cursor with files" FontSize="10" Foreground="#55FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Stacked Cards View -->
                <Canvas x:Name="CardsCanvas" 
                        Width="140" Height="140" 
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="CardsCanvas_MouseDown"
                        MouseMove="CardsCanvas_MouseMove"
                        Cursor="Hand"
                        Visibility="Collapsed"/>

                <!-- Expanded Grid View -->
                <ScrollViewer x:Name="ExpandedScrollViewer" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="220"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="ExpandedItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="130" Height="90" Margin="4"
                                        CornerRadius="12"
                                        Background="#22FFFFFF"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Tag="{Binding}"
                                        MouseLeftButtonDown="ExpandedItem_MouseDown"
                                        MouseMove="ExpandedItem_MouseMove">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Row: Icon & Individual Delete Button -->
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding IconEmoji}" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource HeaderButtonStyle}" 
                                                    Width="18" Height="18" 
                                                    HorizontalAlignment="Right" 
                                                    Content="✕" 
                                                    FontSize="9"
                                                    Tag="{Binding Id}"
                                                    Click="RemoveItemButton_Click"/>
                                        </Grid>

                                        <!-- Middle Row: File Name -->
                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding Name}" 
                                                   ToolTip="{Binding Name}"
                                                   Foreground="White" 
                                                   FontSize="11" 
                                                   FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"/>

                                        <!-- Bottom Row: File Size -->
                                        <TextBlock Grid.Row="2" 
                                                   Text="{Binding FormattedSize}" 
                                                   Foreground="#77FFFFFF" 
                                                   FontSize="9" 
                                                   HorizontalAlignment="Left"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Bottom Pill (File Count & Drag Source & Expand Toggle) -->
            <Border x:Name="BottomPill" Grid.Row="2"
                    HorizontalAlignment="Center"
                    CornerRadius="12"
                    Background="#2AFFFFFF"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="1"
                    Padding="10,4,10,4"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="BottomPill_MouseDown"
                    MouseLeftButtonUp="BottomPill_MouseUp"
                    MouseMove="BottomPill_MouseMove">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ItemCountTextBlock" Text="0 Files" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ExpandChevronTextBlock" Text=" ▼" Foreground="#88FFFFFF" FontSize="8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
